{
  "name": "gesture-wheelchair-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "pages": "node scripts/make-profile-pages.mjs",
    "build": "node scripts/make-profile-pages.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir .ssr --base / && node scripts/prerender.mjs",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "vite": "^5.4.10"
  }
}
